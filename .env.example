# Authentication — Clerk. Required for /dashboard and the leads API
# (GET /api/leads, POST /api/leads/:id/reprocess) to work at all — both are
# protected and the app will not build/run without valid keys, since
# ClerkProvider wraps the whole app in the root layout.
#
# 1. Sign up at https://dashboard.clerk.com and create an application.
# 2. Copy the Publishable key and Secret key from the API Keys page.
# 3. Paste them below.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Without these, auth.protect() (used by /dashboard) redirects unauthenticated
# users to Clerk's hosted Account Portal (accounts.<your-domain>) instead of
# this app's own /sign-in and /sign-up pages. Required in production if your
# domain can't have an "accounts." subdomain configured (e.g. a shared
# *.vercel.app domain).
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# On a shared *.vercel.app domain with a live key, @clerk/nextjs auto-detects
# that it should proxy ClerkJS through this app at /__clerk (see the Frontend
# API auto-proxy note in ARCHITECTURE.md's Authentication section) — but that
# auto-detection reads Vercel's system env vars (VERCEL_TARGET_ENV etc.),
# which are server-only and never reach client-side JS. Set this explicitly
# (a NEXT_PUBLIC_ var, so it's inlined into both server and client bundles
# identically) so the client-side Clerk instance resolves the same proxy path
# the server did — without it, lazy-loaded pieces like the prebuilt <SignIn>
# UI silently fall back to Clerk's unproxied (and here, unreachable) domain.
NEXT_PUBLIC_CLERK_PROXY_URL=/__clerk

# Database — Postgres.
#
# Local dev: docker compose up -d, then this points at that container.
# Port 5433 (not the Postgres default 5432) to avoid colliding with other
# local projects that also run Postgres in Docker on 5432.
# Production (Vercel + Neon): set DATABASE_URL to Neon's POOLED connection
# string (required for serverless functions) and DIRECT_URL to Neon's
# DIRECT (unpooled) connection string, which `prisma migrate` needs because
# migrations use features PgBouncer's pooled connections don't support.
# See README.md for the exact Neon + Vercel setup.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/sift?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/sift?schema=public"

# AI scoring — optional. Without this, Sift falls back to a deterministic
# rule-based scorer so the pipeline still works end to end.
ANTHROPIC_API_KEY=

# CRM adapter — optional. Without these, leads are still fully recorded in
# Sift's own database and shown on the dashboard as if it were the CRM.
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# Notifications — optional. Without this, the Slack message is logged and
# rendered in the in-app activity feed instead of actually posted.
SLACK_WEBHOOK_URL=

# Email fallback — optional. Used only if a Slack post fails.
RESEND_API_KEY=
NOTIFY_EMAIL_FROM=
NOTIFY_EMAIL_TO=

# Per-source intake signing secrets — optional. Format: INTAKE_SECRET_<SOURCE>.
# Without a matching secret, that source's endpoint accepts unsigned requests
# (fine for the demo form; set one before wiring a real external webhook).
INTAKE_SECRET_WEBSITE=
